    - rid: 6774952781063389272
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '*mumbling* ...what? No, wait!

          Sorry, you aren''t
          really interrupting anything... though I wish you <b>were</b>.

          I''m
          supposed to be working but I just... can''t seem to concentrate right now!

          I''m
          perpetually surrounded by distractions!'
        characterEmotion: 5
        characterReaction: 7
