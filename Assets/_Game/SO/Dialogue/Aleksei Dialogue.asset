    - rid: 767062219271962629
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[How would you know?]'
        nextNode:
          rid: 3046478928603512909
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4905, y: 25}
    - rid: 3046478928603512907
      type: {class: AltDialoguePath, ns: , asm: Assembly-CSharp}
      data:
        altDialogue: '*mumbling* ...oh, you''re still here, huh?

          I don''t
          get it, you could leave right now and no-one would bat an eye, and yet
          you stay in this boring excuse of a place.

          Meanwhile, here I
          am, still having to work, still surrounded by nothing but distractions...'
        dialogueReference: {fileID: 0}
        condition:
          dialogueText: 'No, wait!

            You aren''t really interrupting anything...

            I''m
            supposed to be working but I just can''t seem to concentrate right now!

            I''m
            perpetually surrounded by distractions!'
          characterEmotion: 0
          characterReaction: 0
          doesItProveAnything: 0
          isKey: 0
          responses:
