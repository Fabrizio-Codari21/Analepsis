  m_Name: Aleksei Dialogue
  m_EditorClassIdentifier: 
  dialogueColor: {r: 0, g: 0, b: 0, a: 0}
  startingNode:
    dialogueText: '*mumbling* Don''t interrupt me, please.'
    characterEmotion: 0
    characterReaction: 0
    doesItProveAnything: 0
    isKey: 0
    responses:
