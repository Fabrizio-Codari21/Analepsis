    - rid: 3046478928603512908
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(In other words... you don''t know. Great.)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6330, y: 25}
    - rid: 3046478928603512909
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Honey, I <b>always</b> know.

          Everyone seems to
          think they go by unnoticed, but I can just <b>feel</b> them staring, thinking
          "Wow, that guy seems so cool, he''s probably thinking about very important
          stuff".

          And they''d be right about both of those things. Such
          is the curse of the artist, I''m afraid...'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
