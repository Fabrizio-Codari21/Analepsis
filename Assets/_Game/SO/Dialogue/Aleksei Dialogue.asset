        editorPosition: {x: 2486, y: 431}
    - rid: 6774952781063389280
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'What''s worse is, I cannot, for the life of me, get rid of
          the paparazzis! Not even here!

          I just <b>heard</b> that damn
          camera shutter. If I ever find them, I have a word or two to say to whoever
          is taking pictures! At my! Spiritual! Retreat!'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
