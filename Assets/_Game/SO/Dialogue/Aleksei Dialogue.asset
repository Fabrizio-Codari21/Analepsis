        tag: 
    - rid: 6774952781063389278
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh yeah, I can't catch a break from all the fame...\nIt's
          hard, you know? Everyone wanting to look at you, take pictures of you,
          interview you...It's always about me- I mean you. \nHonestly, honey? Sometimes,
          I don't even know how I do it. Anyone less than me would probably crumble
          to such pressure in an instant."
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
