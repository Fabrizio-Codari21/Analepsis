          Part3: 2868873098
          Part4: 766361834
        tag: 
    - rid: 6774952781063389276
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Uhm...]'
        nextNode:
          rid: 6774952781063389277
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2509, y: 200}
    - rid: 6774952781063389277
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Honestly, I don''t know why anyone would ever want to come
          here!

          There''s absolutely nothing to be found in the barren
          wasteland.

          Come to think of it, what are <b>you</b> doing here?'
        characterEmotion: 2
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389282
        - rid: 6774952781063389283
        isRootNode: 0
        editorPosition: {x: 2719.0005, y: 132.15001}
        altDialoguePaths: []
        guid:
          Part1: 1638892124
          Part2: 1148913163
          Part3: 1816418959
          Part4: 2822193649
        tag: 
    - rid: 6774952781063389278
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh yeah, I can't catch a break from all the fame...\nIt's
          hard, you know? Everyone wanting to look at you, take pictures of you,
          interview you... It's always about me- I mean you. \nHonestly, honey? Sometimes,
          I don't even know how I do it. Anyone less than me would probably crumble
          to such pressure in an instant."
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389279
        - rid: 3046479050573086720
        isRootNode: 0
        editorPosition: {x: 1603.0002, y: 524.1501}
