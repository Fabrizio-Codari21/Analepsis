          Part4: 4211439072
        tag: 
    - rid: 6774952781063389279
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Did you see anyone do that here?]'
        nextNode:
          rid: 6774952781063389280
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2509, y: 786.9034}
    - rid: 6774952781063389280
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Worse. I <b>heard</b> them. That damn camera shutter... a
          sound I will always recognize. \nUnbelievable! I cannot, for the life of
          me, get rid of the paparazzis! Not even here!\nIf I ever find them, I have
          a word or two to say to whoever is taking pictures! At my! Spiritual! Retreat!"
        characterEmotion: 5
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
