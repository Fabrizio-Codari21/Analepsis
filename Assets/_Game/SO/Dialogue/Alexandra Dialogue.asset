    - rid: 6774952781063389331
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Lucklily I''m not anymore!

          My fingers would cram
          if I had to put into words the inadequacy with which the Chef made lunch
          today.

          That borshch was truly abhorrent...'
        characterEmotion: 5
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
