          Part4: 1501563185
        tag: 
    - rid: 6774952781063389330
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'I''m a <b>journalist</b>, mind you. I didn''t spend years
          of my life as the only woman in a prestigious journalism school just to
          be called a <b>reporter</b>.

          But now that you ARE getting curious,
          I''ll tell you: yes, I''m here as a journalist, getting into the least
          expected places to find the most <b>delicious</b> stories.

          No
          pun intended.'
        characterEmotion: 1
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389325
        - rid: 6774952781063389326
        - rid: 3046479020823150684
        isRootNode: 0
        editorPosition: {x: 2741.7046, y: 503.00006}
