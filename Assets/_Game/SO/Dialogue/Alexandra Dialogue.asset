  m_Script: {fileID: 11500000, guid: 86211e2fd74fb484598c1176279aee61, type: 3}
  m_Name: Alexandra Dialogue
  m_EditorClassIdentifier: 
  dialogueColor: {r: 0, g: 0, b: 0, a: 0}
  startingNode:
    dialogueText: Ok, so what's your deal?
    characterEmotion: 2
    characterReaction: 0
    doesItProveAnything: 0
    isKey: 0
    responses:
    - rid: 6774952739558129733
    isRootNode: 1
