    - rid: 3046478613006778478
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Sorry. (What could be so dangerous?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3279.2124, y: 205.00003}
    - rid: 3046478613006778479
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Roger that. (Wait... still alive?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3009.5, y: -70.299995}
    - rid: 3046478613006778480
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Then do me a favour and remind him that I said MANY TIMES
          that I would be the one taking care of that.

          And make sure that
          he keeps in mind that he''s in debt with me, and that he''s still <b>alive</b>
          for a reason.'
        characterEmotion: 3
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
