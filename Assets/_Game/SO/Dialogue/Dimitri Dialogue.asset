  m_Script: {fileID: 11500000, guid: 86211e2fd74fb484598c1176279aee61, type: 3}
  m_Name: Dimitri Dialogue
  m_EditorClassIdentifier: 
  dialogueColor: {r: 0, g: 0, b: 0, a: 0}
  startingNode:
    dialogueText: 'How the... *sigh* I knew the code was too easy to guess.

      Oh,
      well, at least it wasn''t <b>him</b> who figured it out.

      So what''s
      your deal? Are you a reporter? A spy? An officer? What should I do with you?'
    characterEmotion: 2
    characterReaction: 0
    doesItProveAnything: 0
    isKey: 0
    responses:
    - rid: 767062219271962644
    - rid: 3046478613006778468
    isRootNode: 1
    editorPosition: {x: 135.0954, y: 189.25099}
    altDialoguePath:
      altDialogue: "Did you really not get the message? \nLet's see if you get it
        now: 10, 9, 8, 7..."
      dialogueReference: {fileID: 11400000}
      condition:
        dialogueText: 'If that''s the case, from one spy to another, none of this
          shouldn''t be of your concern.

          You''re smart, I respect that,
          so I''ll tell you this: we''re not here to kill anyone.

          i''ll
          let this slide, but if you dare enter here again... let''s just say it
          will no longer be a murder "attempt", if you get my drift.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046478613006778470
        isRootNode: 0
        editorPosition: {x: 1406, y: 372.8804}
