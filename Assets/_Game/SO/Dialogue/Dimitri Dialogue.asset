    - rid: 3046478613006778468
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''m investigating a possible murder attempt.]'
        nextNode:
          rid: 3046478613006778469
        dialogueTopic: 
        m_conditions:
        - rid: 3046478613006778514
        alreadyDisplayed: 0
        editorPosition: {x: 820, y: 350.00003}
    - rid: 3046478613006778469
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'If that''s the case, from one spy to another, none of this
          shouldn''t be of your concern.

          You''re smart, I respect that,
          so I''ll tell you this: we''re not here to kill anyone.

          i''ll
          let this slide, but if you dare enter here again... let''s just say it
          will no longer be a murder "attempt", get what I''m saying?.'
        characterEmotion: 3
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
