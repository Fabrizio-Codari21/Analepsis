          Part1: 2824955012
          Part2: 1279284701
          Part3: 1091494021
          Part4: 164643856
        tag: 
    - rid: 3046479065253413044
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(What''s going on here...?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4539, y: 578}
    - rid: 3046479065253413046
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Why would I be any of those things?]'
        nextNode:
          rid: 3046479065253413047
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 740.99994, y: 506.39}
    - rid: 3046479065253413047
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'What else, then? The world''s best guesser? A time traveler?
          A detective with a magical notebook?

          I have no time for jokes,
          much less for you. I''ll pretend you didn''t just intrude, for you own
          safety, so <b>leave</b>.'
        characterEmotion: 3
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253413049
        isRootNode: 0
        editorPosition: {x: 1116, y: 584}
        altDialoguePaths: []
        guid:
          Part1: 2251030260
