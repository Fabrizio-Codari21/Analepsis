          Part3: 4089636743
          Part4: 2614750270
        tag: 
    - rid: 3046479065253413049
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Alright, sorry. (Wow... that was weirdly accurate.)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 1880, y: 620}
