          Part3: 2245772943
          Part4: 1085929645
        tag: 
    - rid: 3046479065253413174
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[If you say so. (What''s he up to...?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4511.6006, y: 57.30004}
    - rid: 3046479097160531980
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: 699f9b3a387b8a941af3909649b0f034, type: 2}
        isTalkDialogueNode:
          dialogueText: 'Well, you see, it''s... my... roommate challenged me to
            find a certain "code" that he came up with.

            Let''s just
            say I need to find it fast if I want to get access to... my reward...'
          characterEmotion: 1
          characterReaction: 2
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 3046479097160532002
          isRootNode: 0
          editorPosition: {x: 2202.7424, y: -100.9025}
