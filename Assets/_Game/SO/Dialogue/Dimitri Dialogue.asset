    - rid: 3046478613006778481
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '...Please tell me you''re joking. There must have been a good
          reason for Oleg to let you in, and clearly your intelligence is not it.

          Look,
          just... stay out of this, alright? Clearly you''re not very well prepared,
          and you could easily get caught in the crossfire, so it''s better if you
          don''t get involved.'
        characterEmotion: 2
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
