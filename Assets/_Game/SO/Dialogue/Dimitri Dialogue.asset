    - rid: 3046478613006778474
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[He asked me to get... um... "the thing".]'
        nextNode:
          rid: 3046478613006778480
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 1881.0001, y: -66}
    - rid: 3046478613006778475
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Can I be of any help?]'
        nextNode:
          rid: 3046478613006778481
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 1888.6775, y: 205.00002}
    - rid: 3046478613006778476
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Well, you''re the first and only person to come into this
          room, so nothing''s gone wrong so far.

          Though, of course, I
          didn''t account on you being a part of this so, please don''t get in the
          way.

          This is a very serious business for me, alright?'
        characterEmotion: 1
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
