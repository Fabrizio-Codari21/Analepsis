    - rid: 3046478613006778462
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Cameras? Like that journalist downstairs?]'
        nextNode:
          rid: 3046478613006778464
        dialogueTopic: 
        m_conditions:
        - rid: 3046478613006778465
        alreadyDisplayed: 0
        editorPosition: {x: 3583.0005, y: -91.999985}
    - rid: 3046478613006778463
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(Oh, no! I''ve screwed it...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6058.0347, y: -281.99982}
    - rid: 3046478613006778464
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Lucky for her, she seems to be a bit vain to care about politics
          and my role in them.

          Admittedly, that could make her even more
          suspicious... but her focus seems to be placed on Mr. Artist instead.

          He''s
          truly useless, but hey, at least his weirdness makes him the perfect distraction...
          heh...'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
