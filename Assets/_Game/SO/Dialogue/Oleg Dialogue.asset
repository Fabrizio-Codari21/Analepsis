        tag: 
    - rid: 3046478613006778446
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "You don't say. As if being \"famous\" was the worst part of
          it. \nPeople like you wondering about my personal life, with nothing but
          questions in mind and cameras in hand, are just an unavoidable trait of
          my job.\nIt's the people who believe to already know enough about me who
          make things difficult, since they are the ones that always feel the need
          to... \"do something\" about me."
        characterEmotion: 0
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046478613006778444
        - rid: 3046478613006778462
