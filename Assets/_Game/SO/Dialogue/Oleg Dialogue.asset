    - rid: 767062219271962647
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I was actually looking for you, sir.]'
        nextNode:
          rid: 3046478613006778445
        dialogueTopic: 
        m_conditions:
        - rid: 3046478613006778452
        alreadyDisplayed: 0
        editorPosition: {x: 620, y: 62}
    - rid: 3046478613006778441
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Oh, my bad. (leave)] '
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions:
        - rid: 3046478613006778453
        alreadyDisplayed: 0
        editorPosition: {x: 620, y: 244}
    - rid: 3046478613006778442
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''ve heard you''re famous. Must be hard, huh?]'
        nextNode:
          rid: 3046478613006778446
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2062, y: -82.354996}
    - rid: 3046478613006778443
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Some people here told me about you...]'
        nextNode:
          rid: 3046478613006778460
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2094, y: 132.00002}
    - rid: 3046478613006778444
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Has that already happened to you here?]'
        nextNode:
          rid: 3046478613006778455
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3630.0352, y: -336.99988}
    - rid: 3046478613006778445
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Is that so? Well, I don''t suppose your presence will be causing
          me any problems... otherwise you probably wouldn''t have been able to get
          this close to me...

          Tell me then, why were you so interested
          in finding me?'
        characterEmotion: 2
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
