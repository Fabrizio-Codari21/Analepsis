  m_Script: {fileID: 11500000, guid: 86211e2fd74fb484598c1176279aee61, type: 3}
  m_Name: Oleg Dialogue
  m_EditorClassIdentifier: 
  dialogueColor: {r: 0, g: 0, b: 0, a: 0}
  startingNode:
    dialogueText: 'Excuse you, sir: you''re in MY bedroom right now.

      You must
      have gotten the wrong room number. Please leave.'
    characterEmotion: 3
    characterReaction: 7
    doesItProveAnything: 0
    isKey: 0
    responses:
    - rid: 767062219271962647
    - rid: 3046478613006778441
    isRootNode: 1
    editorPosition: {x: 54, y: 170}
    altDialoguePath:
      altDialogue: "Wow, you're persistent. \nLet me make myself clear: no, I'm not
        interested in talking to a spy like you."
      dialogueReference: {fileID: 11400000}
      condition:
        dialogueText: '...yeah, sure. And I suppose you''re now expecting me to "be
          cooperative" so that you may "protect me" from a "menace".

          Pro
          tip, kid: if you''re going to try and spy a major figure, make sure not
          to use the oldest trick from the book first.

          Do yourself a favour
          and get out of my sight.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses: []
        isRootNode: 0
        editorPosition: {x: 5233.0815, y: -167}
