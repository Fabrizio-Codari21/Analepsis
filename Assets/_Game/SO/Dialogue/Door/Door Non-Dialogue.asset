          Part4: 2548608221
        tag: 
    - rid: 3046478823175749722
      type: {class: ItemNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        item: {fileID: 11400000, guid: 2644e5ade1590fd48a3faefc742741ba, type: 2}
    - rid: 3046479087689794327
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: a218568596dfcf9419f1f4c8eb4ff384, type: 2}
        isTalkDialogueNode:
          dialogueText: 'Excuse you, sir: you''re in MY bedroom right now.

            You
            must have gotten the wrong room number. Please, leave.'
          characterEmotion: 3
          characterReaction: 7
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 3046479087689794328
          - rid: 3046479087689794329
          isRootNode: 1
          editorPosition: {x: 54, y: 170}
          altDialoguePaths: []
          guid:
            Part1: 3211227619
            Part2: 1091559491
            Part3: 2738512044
            Part4: 2089523068
          tag: 
    - rid: 3046479087689794328
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I was actually looking for you, sir.]'
        nextNode:
          rid: 3046479087689794330
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 599.0001, y: 86.99997}
    - rid: 3046479087689794329
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I was told that my room was <b>no. 2</b>...]'
        nextNode:
          rid: 3046479087689794331
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 599.15015, y: 298.00003}
    - rid: 3046479087689794330
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Is that so? Well, I don''t suppose your presence will be causing
          me any problems... otherwise you probably wouldn''t have been able to get
          this close to me...

          Tell me then, why were you so interested
          in finding me?'
        characterEmotion: 2
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794332
        - rid: 3046479087689794333
        isRootNode: 0
        editorPosition: {x: 999, y: 43}
        altDialoguePaths: []
        guid:
          Part1: 3420732108
          Part2: 1074501888
          Part3: 1118841494
          Part4: 3893310346
        tag: 
    - rid: 3046479087689794331
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "You were lied to, then. \nIt's already bad enough that I had
          to lose my suite to some... filthy artist; I'm not going to negotiate with
          a mere commoner like you.\nYou better find another room... or sleep downstairs,
          for all I care."
        characterEmotion: 3
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794334
        isRootNode: 0
        editorPosition: {x: 1021.02264, y: 318}
        altDialoguePaths: []
        guid:
          Part1: 2754526002
          Part2: 1138548354
          Part3: 498545549
          Part4: 1940995327
        tag: 
    - rid: 3046479087689794332
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''ve heard you''re famous. Must be hard, huh?]'
        nextNode:
          rid: 3046479087689794335
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 1949.9998, y: -198.6587}
    - rid: 3046479087689794333
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Some people here seem to know you...]'
        nextNode:
          rid: 3046479087689794336
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2105, y: 108}
    - rid: 3046479087689794334
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So, you should be in another room?] '
        nextNode:
          rid: 3046479087689794337
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 1869.9999, y: 364.159}
    - rid: 3046479087689794335
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "You don't say. As if being \"famous\" was the worst part of
          it. \nPeople like you wondering about my personal life, with nothing but
          questions in mind and cameras in hand, are just an unavoidable trait of
          my job.\nIt's the people who believe to already know enough about me who
          make things difficult, since they are the ones that always feel the need
          to... \"do something\" about me."
        characterEmotion: 0
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794338
        - rid: 3046479087689794339
        isRootNode: 0
        editorPosition: {x: 2359.2307, y: -329.61264}
        altDialoguePaths: []
        guid:
          Part1: 3751126033
          Part2: 1310427781
          Part3: 14493372
          Part4: 3819777033
        tag: 
    - rid: 3046479087689794336
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Let me guess, was it the man who always seems to look confused?
          Yeah, that''s... Ilya, I think his name was.

          I had to be driven
          here by him after his incompetence caused my car to stop working in the
          middle of the road.

          I would advise not spending much time with
          him, unless you want him to ruin your stuff out of pure idiocy.'
        characterEmotion: 2
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794340
        - rid: 3046479087689794341
        isRootNode: 0
        editorPosition: {x: 2539.2903, y: 113.000015}
        altDialoguePaths: []
        guid:
          Part1: 4061733524
          Part2: 1237221908
          Part3: 4047279270
          Part4: 4184659917
        tag: 
    - rid: 3046479087689794337
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'It''s what I get for trusting in the integrity of such a miserable
          establishment.

          You''d think that they would understand the idea
          of "reservation", regardless of how late one may arrive...

          But
          I guess that was too much to ask from a host who seemingly doesn''t even
          know numbers...'
        characterEmotion: 1
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794342
        isRootNode: 0
        editorPosition: {x: 2254, y: 395}
        altDialoguePaths: []
        guid:
          Part1: 4043970722
          Part2: 1242736572
          Part3: 4036692107
          Part4: 387059162
        tag: 
    - rid: 3046479087689794338
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Has that already happened to you here?]'
        nextNode:
          rid: 3046479087689794343
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3630.0352, y: -336.99988}
    - rid: 3046479087689794339
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Cameras? Like that journalist downstairs?]'
        nextNode:
          rid: 3046479087689794344
        dialogueTopic: 
        m_conditions:
        - rid: 3046479087689794345
        alreadyDisplayed: 0
        editorPosition: {x: 3407, y: -215}
    - rid: 3046479087689794340
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Thanks for the tip. (Ilya broke his car, then...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3332.5503, y: -4.9500294}
    - rid: 3046479087689794341
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I meant the person behind that door...]'
        nextNode:
          rid: 3046479087689794346
        dialogueTopic: 
        m_conditions:
        - rid: 3046479087689794347
        alreadyDisplayed: 0
        editorPosition: {x: 3313.45, y: 205.75}
    - rid: 3046479087689794342
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(It certainly is strange...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2997, y: 416}
    - rid: 3046479087689794343
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why do you think I chose a place in the middle of nowhere
          such as this?

          Trust me, I know how to deal with these things...
          some day, someone will get me, but today is not that day, I know it...

          Then
          again, I''m not entirely sure why someone like you is so interested on
          my safety... unless...'
        characterEmotion: 2
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794348
        - rid: 3046479087689794349
        isRootNode: 0
        editorPosition: {x: 4025.8733, y: -382.50006}
        altDialoguePaths: []
        guid:
          Part1: 474974818
          Part2: 1123759463
          Part3: 482866062
          Part4: 531188890
        tag: 
    - rid: 3046479087689794344
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Lucky for her, she seems to be a bit vain to care about politics
          and my role in them.

          Admittedly, that could make her even more
          suspicious... but her focus seems to be placed on Mr. Artist instead.

          He''s
          truly useless, but hey, at least his weirdness makes him the perfect distraction...
          heh...'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
