    - rid: -2
      type: {class: , ns: , asm: }
    - rid: 767062716024619009
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[It''s Ilya, can you open the door?]'
        nextNode:
          rid: 767062716024619026
        dialogueTopic: 
        m_conditions:
        - rid: 767062716024619011
        alreadyDisplayed: 0
        editorPosition: {x: 1483, y: 161.32}
    - rid: 767062716024619011
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: 699f9b3a387b8a941af3909649b0f034, type: 2}
        isTalkDialogueNode:
          dialogueText: '...getting into my room, I''m afraid.

            The thing
            is this "game" was mostly just a way to punish me for taking so long
            to arrive.

            He got to set the code of the room before I got
            here, and now he''s asking me to figure it out for myself.

            Which
            is why I''m asking for help, if you don''t mind.'
          characterEmotion: 0
          characterReaction: 0
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 767062716024619020
          - rid: 767062716024619021
          isRootNode: 0
          editorPosition: {x: 3212.9006, y: -100.999985}
          altDialoguePaths: []
          guid:
            Part1: 239946146
            Part2: 1266075066
            Part3: 581738174
            Part4: 4257914823
          tag: 
    - rid: 767062716024619020
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Ok, I''ll help.]'
        nextNode:
          rid: 767062716024619022
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3970, y: -310}
    - rid: 767062716024619021
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Can I meet your roommate then?]'
        nextNode:
          rid: 767062716024619023
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3970, y: -104}
    - rid: 767062716024619022
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Wow, thank you... *phew* just... make sure to not tell anyone
          else once you figure it out.

          I wouldn''t want people to just...
          interrupt us once I''m inside.'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 767062716024619024
        isRootNode: 0
        editorPosition: {x: 4233.1514, y: -368}
        altDialoguePaths: []
        guid:
          Part1: 3944833965
          Part2: 1299830704
          Part3: 104953494
          Part4: 72952190
        tag: 
    - rid: 767062716024619023
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '<b>NO!</b> *cough* I mean, I''d love to, but he... um... doesn''t
          like to receive strangers, so I''d rather not, sorry.

          Please,
          if you happen to find out what the code might be, I''d be really thankful.
          And, um, don''t tell it to anyone else, ok?'
        characterEmotion: 5
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 767062716024619025
        isRootNode: 0
        editorPosition: {x: 4330, y: -104}
        altDialoguePaths: []
        guid:
          Part1: 3819829899
          Part2: 1308653073
          Part3: 102641286
          Part4: 3373460120
        tag: 
    - rid: 767062716024619024
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(I''m afraid to ask what they could "interrupt".)] '
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
