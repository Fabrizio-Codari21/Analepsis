    - rid: 767062716024619031
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Me, Oleg]'
        nextNode:
          rid: 767062716024619034
        dialogueTopic: 
        m_conditions:
        - rid: 767062716024619032
        alreadyDisplayed: 0
        editorPosition: {x: 1525, y: 381}
    - rid: 767062716024619032
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: a218568596dfcf9419f1f4c8eb4ff384, type: 2}
        isTalkDialogueNode:
          dialogueText: 'Let me guess, was it the man who always seems to look confused?
            Yeah, that''s... Ilya, I think his name was.

            I had to be
            driven here by him after his incompetence caused my car to stop working
            in the middle of the road.

            I would advise not spending much
            time with him, unless you want him to ruin your stuff out of pure idiocy.'
          characterEmotion: 0
          characterReaction: 0
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 767062716024619033
          isRootNode: 0
          editorPosition: {x: 2501, y: 156.50002}
