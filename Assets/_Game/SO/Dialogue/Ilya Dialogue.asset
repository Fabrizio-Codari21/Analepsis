      data:
        altDialogue: Nice to see you again, comrade. Nothing to report so far.
        condition:
          dialogueText: D-Dimitri did that? Wait... does that mean that.. you already
            know...?
          characterEmotion: 0
          characterReaction: 0
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 3046478613006778497
