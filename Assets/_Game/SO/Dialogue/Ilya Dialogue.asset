    - rid: 3046478908010004714
      type: {class: AltDialoguePath, ns: , asm: Assembly-CSharp}
      data:
        altDialogue: Nice to see you, comrade. Nothing to report so far.
        dialogueReference: {fileID: 0}
        condition:
          dialogueText: 'So he DID get a <b>third</b> member for the team! I knew
            it!

            See, I told him that a mission like this would require
            more hands, but he was too proud to admit that I was right.

            I
            respect him a lot, he was like a... weird, creepy father to me... but,
            man, a <b>figure that important</b> could not go down without help... '
          characterEmotion: 0
          characterReaction: 0
          doesItProveAnything: 0
          isKey: 0
          responses:
          - rid: 3046478613006778498
          - rid: 3046478613006778499
