  m_Script: {fileID: 11500000, guid: 86211e2fd74fb484598c1176279aee61, type: 3}
  m_Name: Ilya Dialogue
  m_EditorClassIdentifier: 
  dialogueColor: {r: 0, g: 0, b: 0, a: 0}
  startingNode:
    dialogueText: Oh... s-sorry, I didn't see you come here. My name's Ilya, pleased
      to meet you.
    characterEmotion: 0
    characterReaction: 0
    doesItProveAnything: 0
    isKey: 0
    responses:
    - rid: 767062219271962645
    isRootNode: 1
    editorPosition: {x: 87, y: 190}
    altDialoguePath:
      altDialogue: Hey, welcome back! Did you find the code yet?
      dialogueReference: {fileID: 11400000}
      condition:
        dialogueText: '...getting into my room, I''m afraid.

          The thing
          is this "game" was mostly just a way to punish me for taking so long to
          arrive.

          He got to set the code of the room before I got here,
          and now he''s asking me to figure it out for myself.

          Which is
          why I''m asking for help, if you don''t mind.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046478613006778489
        - rid: 3046478613006778490
        isRootNode: 0
