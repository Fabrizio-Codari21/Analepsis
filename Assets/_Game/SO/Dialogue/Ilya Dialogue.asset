      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[He asked me to get... um... "the thing".]'
        nextNode:
          rid: 3046479065253413069
        dialogueTopic: 
        m_conditions: []
