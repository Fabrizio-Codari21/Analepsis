      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Ilya was looking for you.]'
        nextNode:
          rid: 3046479065253413080
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 793.69995, y: 288.81952}
    - rid: 3046479065253413076
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Why would I be any of those things?]'
        nextNode:
          rid: 3046479065253413081
        dialogueTopic: 
