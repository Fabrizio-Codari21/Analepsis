      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: Really? Oh, wow, thank you so much! How did you find out about
          it?
        characterEmotion: 4
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
