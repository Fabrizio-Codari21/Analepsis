    - rid: 3046478613006778487
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[And that reward would be...?]'
        nextNode:
          rid: 3046478613006778488
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2881.5, y: -164}
    - rid: 3046478613006778488
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '...getting into my room, I''m afraid.

          The thing
          is this "game" was mostly just a way to punish me for taking so long to
          arrive.

          He got to set the code of the room before I got here,
          and now he''s asking me to figure it out for myself.

          Which is
          why I''m asking for help, if you don''t mind.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
