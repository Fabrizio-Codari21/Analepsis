    - rid: 3046478613006778483
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '(Damn!) *cough* I mean... that''s me, the most... normal guy
          you''ll find around! Heh...

          Hey, so... um... unrelated question,
          could you please help me solve a certain... um... game I''m playing?'
