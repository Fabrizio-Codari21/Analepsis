    - rid: 5324356914828018031
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So you resent her, then?]'
        nextNode:
          rid: 5324356914828018035
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2665, y: 339}
    - rid: 5324356914828018032
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Do you miss her?]'
        nextNode:
          rid: 5324356914828018033
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2680.8804, y: 169.48999}
    - rid: 5324356914828018033
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '...yes. And, unlike what people seem to believe, it''s not
          because of her fortune or my debt with her for allowing me to follow my
          career.

          I genuinely do still love her, and though I know she
          might not reciprocate, I am unable to forget how I was when i was with
          her... *sigh* '
        characterEmotion: 0
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
