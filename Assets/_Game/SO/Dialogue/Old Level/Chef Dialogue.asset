    - rid: 3832489796472668235
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So she can get <b>scary</b>, you say...]'
        nextNode:
          rid: -2
        dialogueTopic: the Maid's problem
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3324.42, y: 627}
    - rid: 5324356914828018021
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So you''re the chef, I assume?]'
        nextNode:
          rid: 5324356914828018022
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 797, y: -52.878784}
    - rid: 5324356914828018022
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Emphasis on "the", I would say. I doubt you''re going to find
          anyone who''s even remotely at my level in these parts.

          Which,
          to be fair, is less of a compliment to myself and more of an insult to
          this barren wasteland of a tundra.'
        characterEmotion: 1
        characterReaction: 7
        doesItProveAnything: 0
        isKey: 0
