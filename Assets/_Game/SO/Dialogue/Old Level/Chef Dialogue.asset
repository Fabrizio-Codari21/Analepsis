    - rid: 5324356914828018038
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[What''s up with the maid?]'
        nextNode:
          rid: 5324356914828018039
        dialogueTopic: 
        m_conditions:
        - rid: 5324356914828018041
        alreadyDisplayed: 0
        editorPosition: {x: 952.50006, y: 493}
    - rid: 5324356914828018039
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh, I feel so sorry for her. \nShe seems to have found an
          ill-intended <b>note</b> on a room threatening her.\nWhoever felt the need
          to do something so cruel wasn't even brave enough to sign..."
