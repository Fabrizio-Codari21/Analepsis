        tag: 
    - rid: 3046478974422614024
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Then, how did you become a chef?]'
        nextNode:
          rid: 3046478974422614025
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6397.5, y: 202}
    - rid: 3046478974422614025
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'I never did, but, you see, in a place as miserable as this,
          working is less about being good at your job, and more about being able
          to <b>survive</b> it.

          Anyone would run away from a place like
          this... but to me, this is nowhere near the worst thing I had to endure.

          Long
          story short: I''m sorry if the food sucks, but literally no-one else would
          ever take my place.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
