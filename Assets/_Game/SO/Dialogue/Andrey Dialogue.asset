    - rid: 767062219271962632
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''m actually investigating something.]'
        nextNode:
          rid: 767062219271962638
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2247, y: 14}
    - rid: 767062219271962633
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Well, I haven''t tried your food yet.]'
        nextNode:
          rid: 767062219271962634
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2281, y: 269}
    - rid: 767062219271962634
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Humph... Well, then it''s best if you don''t... you''d be
          lucky enough to never have to try it.

          I understand why she would
          pick a war veteran for her staff, but she must really hate her guests if
          she decided to put me anywhere near a kitchen.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
