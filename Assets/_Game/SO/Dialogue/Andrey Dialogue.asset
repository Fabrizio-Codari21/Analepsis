    - rid: 767062219271962639
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Do you know anything about the guests?]'
        nextNode:
          rid: 767062219271962640
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3265, y: -152}
    - rid: 767062219271962640
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'If you mean "do I know the latest gossip about them", then
          you''re talking to the wrong person.

          I''m terrible with names,
          faces, and people in general. Apparently, according to Natalia, a couple
          of them are famous; not that I could (or cared to) confirm that, of course.

          Now,
          if what you mean is "do you know who I should suspect from"...'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
