        tag: 
    - rid: 3046478974422614018
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Who do you have in mind?]'
        nextNode:
          rid: 3046478974422614019
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 7497.5, y: -271}
    - rid: 3046478974422614019
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'There''s two men I haven''t seen since right after they checked
          in... who know what they might be doing upstairs.

          At the same
          time, there''s one who hasn''t left the dining hall since then, as if he
          was avoiding going up where the other two are.

          What''s curious
          is, I''ve seen the man downstairs talk to both of the men upstairs... something
          might be up between those three, and I don''t like it one bit.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
