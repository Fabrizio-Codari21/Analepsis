    - rid: 767062219271962643
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[And who does that "radar" point to?]'
        nextNode:
          rid: 3046478974422614017
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6010.5, y: -276}
    - rid: 3046478974422614016
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Why does no one come to this hotel?]'
        nextNode:
          rid: 3046478974422614021
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3265, y: 25}
    - rid: 3046478974422614017
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'For once in my life, not EVERYONE in the hotel... which is
          probably a bad sign.

          Some of them are really going out of their
          way to look suspicious: taking pictures in the open, going into loud rants
          about how "real" their story is... coming in here to ask questions.

          But
          the danger lies on the ones that don''t: the ones who don''t leave their
          place, as if they are waiting for something to unfold...'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
