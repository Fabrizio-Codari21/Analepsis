    - rid: 3046478974422614022
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[It is suspicious indeed...]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4765, y: 29}
    - rid: 3046478974422614023
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "They sure wish that was the case... but no, I was discharged
          because I was too good for my own sake.\nNot at shooting targets, necessarily...
          but at telling which the <b>real</b> targets were. \nI always know when
          someone is willing to betray their comrades, and that made me real dangerous
          for them to keep me."
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
