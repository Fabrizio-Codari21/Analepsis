        tag: 
    - rid: 767062219271962637
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Is that why you quitted?]'
        nextNode:
          rid: 3046478974422614023
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 5070, y: 243}
    - rid: 767062219271962638
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: '...And you lied to her so that you could come in and talk
          to me.

          Humph... That''s dangerous, but admirable. Definitely
          more interesting than the alternative.

          Ask then, please. It''s
          not like I''m ever busy in this desolated hotel.'
