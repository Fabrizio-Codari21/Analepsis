        tag: 
    - rid: 767062219271962635
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So you fought in the war?]'
        nextNode:
          rid: 767062219271962636
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3693, y: 315}
    - rid: 767062219271962636
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Not so much "in" the war, more like "half a mile away" from
          it.

          I was trained to swiftly get one bullet in people''s brains,
          so that lesser soldiers wouldn''t have to waste three hundred bullets just
          to injure a leg.

          Not that that fact spared me from the horrors
          of war... if anything, it made me stare at them through a 25x telescopic
          lens.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
