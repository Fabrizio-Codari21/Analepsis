        editorPosition: {x: 8778.5, y: -276}
    - rid: 3046478974422614021
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Isn''t it obvious? You''re more likely to find a snowman than
          a real man in a hundred mile radius.

          How this place even came
          to be is a mystery not even Natalia can answer... and the fact people would
          stay here should be suspicious by itself.

          You must be a real
          good investigator, if you were even capable of finding this place.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
