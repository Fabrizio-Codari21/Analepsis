    - rid: 6774952781063389261
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[What happened to the Sauna?]'
        nextNode:
          rid: 6774952781063389262
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2037, y: 357.5}
    - rid: 6774952781063389262
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh, a few guests went in and decided to have too much fun!
          Ha-ha! \nDon't worry, they won't be invited again. We'll repair it as soon
          as we find the keys.\nPlease, let me know if you find them somewhere around
          here."
