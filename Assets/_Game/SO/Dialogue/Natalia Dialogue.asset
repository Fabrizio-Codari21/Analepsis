        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 5958.3, y: -645.7617}
    - rid: 3046478936985567313
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Oleg, maybe? He seems to dislike Aleksei.]'
        nextNode:
          rid: 3046478936985567322
