          Part3: 2868873098
          Part4: 766361834
        tag: 
        altDialoguePaths: []
    - rid: 6774952781063389307
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Oh yeah, I can''t catch a break from all the fame...

          It''s
          hard, you know? Everyone wanting to look at you, take pictures of you,
          interview you

          It''s always about you- I mean me. Honestly honey?
          I don''t know how I do it'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389309
        isRootNode: 0
