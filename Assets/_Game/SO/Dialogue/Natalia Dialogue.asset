    - rid: 3046478936985567312
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Do you know who was behind that article?]'
        nextNode:
          rid: 3046478936985567321
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 5925.5513, y: -334}
    - rid: 3046478936985567313
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I think it was Oleg himself.]'
        nextNode:
          rid: 3046478936985567322
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6928, y: -251.00005}
    - rid: 3046478936985567314
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I think it was Alexandra.]'
        nextNode:
          rid: 3046478936985567323
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 6928, y: -464.12524}
    - rid: 3046478936985567315
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
