      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why, thank you for choosing us, sir! It''s great to see people
          come in instead of passing by, for once.

          You can find your very
          own room no. 2 upstairs, quite near our beautiful, temporarily in reparations,
          sauna!

          Dinner will be served at 7pm, so please make yourself
          at home.'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
