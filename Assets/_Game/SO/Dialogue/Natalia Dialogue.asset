        tag: 
    - rid: 767062761356918899
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''m looking forward to trying it out.]'
        nextNode:
          rid: 767062761356918900
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3049, y: 171}
    - rid: 767062761356918900
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh I hope you like it, I really do! \nBy the way... You see,
          our chef, Andrey, hasn't been feeling his best lately. \nThe hotel is never
          really busy but he seems to be contantly stressed out! Like a poor creature
          sensing a looming threat..."
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
