        tag: 
    - rid: 767062761356918876
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "And what better for that than a cozy hotel! \nWe all know
          that that business always take place in isolated, but seemingly innocuous
          places.\nTake the <b>sauna</b> upstairs, for instance... if it wasn't for
          the fact that the door won't budge, that would be perfect for negotiating.\nThey
          should have hung up the right sign, though.. my nose still hurts from trying
          to open it..."
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 767062761356918881
        isRootNode: 0
        editorPosition: {x: 5341, y: 431.99997}
        altDialoguePaths: []
        guid:
          Part1: 2103101816
          Part2: 1171027430
          Part3: 1203153824
          Part4: 517255940
        tag: 
    - rid: 767062761356918877
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Oh... Crap, I guess you''re right.

          Ok, you got
          me: while I DID arrive too late to take pictures of my main target, I,
          um... decided to take the opportunity to photograph the... next best thing
          here.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 767062761356918882
        isRootNode: 0
        editorPosition: {x: 5370.773, y: 864.9999}
