        editorPosition: {x: 6928, y: -464.12524}
    - rid: 3046478936985567315
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(That''s way too recent... but also interesting.)]'
        nextNode:
