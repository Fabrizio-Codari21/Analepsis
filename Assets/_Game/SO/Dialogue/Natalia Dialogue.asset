  startingNode:
    dialogueText: Greetings! Welcome to our humble hotel, what can I do for you?
    characterEmotion: 4
    characterReaction: 2
    doesItProveAnything: 4
    isKey: 0
    responses:
    - rid: 6774952781063389258
    isRootNode: 1
    editorPosition: {x: 373.04575, y: 67.000015}
    guid:
