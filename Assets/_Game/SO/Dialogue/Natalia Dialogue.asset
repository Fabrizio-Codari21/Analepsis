          tag: 
    - rid: 3046479065253413007
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I was actually looking for you, sir.]'
        nextNode:
          rid: 3046479065253413009
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 599.0001, y: 86.99997}
    - rid: 3046479065253413008
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I was told that my room was <b>no. 2</b>...]'
        nextNode:
          rid: 3046479065253413010
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 599.15015, y: 298.00003}
    - rid: 3046479065253413009
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Is that so? Well, I don''t suppose your presence will be causing
          me any problems... otherwise you probably wouldn''t have been able to get
          this close to me...

          Tell me then, why were you so interested
          in finding me?'
        characterEmotion: 2
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253413011
        - rid: 3046479065253413012
        isRootNode: 0
        editorPosition: {x: 999, y: 43}
        altDialoguePaths: []
        guid:
          Part1: 3420732108
          Part2: 1074501888
          Part3: 1118841494
          Part4: 3893310346
        tag: 
    - rid: 3046479065253413010
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "You were lied to, then. \nIt's already bad enough that I had
          to lose my suite to some... filthy artist; I'm not going to negotiate with
          a mere commoner like you.\nYou better find another room... or sleep downstairs,
          for all I care."
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
