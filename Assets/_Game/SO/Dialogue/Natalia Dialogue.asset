        editorPosition: {x: 4832.035, y: -263.9999}
    - rid: 3046479065253413026
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(So she''s interested on an artist...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
