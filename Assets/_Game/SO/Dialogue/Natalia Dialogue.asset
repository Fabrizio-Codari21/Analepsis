    - rid: 3046479065253413004
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Is that why my room is already <b>taken</b>?]'
        nextNode:
          rid: 3046479065253413005
        dialogueTopic: 
        m_conditions:
        - rid: 3046479065253413006
        alreadyDisplayed: 0
        editorPosition: {x: 3180.15, y: -163.54997}
    - rid: 3046479065253413005
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'What? Oh... I-I did say room <b>no. 2</b>, didn''t I?

          Hold
          on, let me check... (huh... oh... oh, no...) *clears throat* Y-You''ll
          have to excuse us, sir, I m-may have overbooked our rooms.

          You
          m-might have to wait until... s-someone leaves... please, don''t leave,
          though...'
        characterEmotion: 5
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253413031
        isRootNode: 0
        editorPosition: {x: 3602, y: -164.00005}
        altDialoguePaths: []
        guid:
          Part1: 1325645269
          Part2: 1165886016
          Part3: 3756250030
          Part4: 2686796932
        tag: 
    - rid: 3046479065253413006
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: a218568596dfcf9419f1f4c8eb4ff384, type: 2}
        isTalkDialogueNode:
          dialogueText: 'Excuse you, sir: you''re in MY bedroom right now.

            You
            must have gotten the wrong room number. Please, leave.'
          characterEmotion: 3
          characterReaction: 7
          doesItProveAnything: 0
          isKey: 0
