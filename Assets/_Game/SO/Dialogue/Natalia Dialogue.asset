          Part4: 517255940
        tag: 
    - rid: 767062761356918877
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Oh... Crap, I guess you''re right.

          Ok, you got
          me: while I DID arrive too late to take pictures of my main target, I,
          um... decided to take the opportunity to photograph the... next best thing
          here.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
