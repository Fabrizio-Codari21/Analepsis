    - rid: 767062761356918898
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Well, I always prefer to have the chef surprise us with whatever
          idea he comes up with.

          All that I can say is that it will be
          delicious; I guarantee it.

          Though, if you have any allergies,
          it''s probably best if you tell me in advance.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
