      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I will, thanks. (So the sauna is <b>locked</b>)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4464.6025, y: 691}
    - rid: 3046479065253412948
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So, no one could be... making <b>noise</b> there?]'
        nextNode:
