    - rid: 3046479065253413119
      type: {class: DialogueNodeCondition, ns: , asm: Assembly-CSharp}
      data:
        conditionName: 
        unlockIfTrue: 1
        targetDialogue: {fileID: 11400000, guid: 89cdbcac6674ef748a2334d6de5a8fce, type: 2}
        isTalkDialogueNode:
          dialogueText: 'Oh, sorry, my bad: I used to be a <b>food</b> critic, hence
            the <b>delicious</b> thing... Nevermind, it was bad anyways.

            Luckily
            for the staff here, I''m not anymore! My fingers would cram if I had
            to put into words the absolute trainwreck that was today''s lunch.

            That
            borshch was truly abhorrent... Who hired this Chef?'
          characterEmotion: 5
          characterReaction: 2
          doesItProveAnything: 0
          isKey: 0
          responses:
