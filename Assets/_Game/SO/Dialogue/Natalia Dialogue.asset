    - rid: 6774952781063389306
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'My magnum opus of course!

          I came to this hotel
          in the middle of nowhere to help me focus

          Art isn''t done in
          between parties and drugs, or so my acquaintances insisted before draggin
          me here with their constant negging...'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389308
        isRootNode: 0
        editorPosition: {x: 1685, y: 200}
