      type: {class: AltDialoguePath, ns: , asm: Assembly-CSharp}
      data:
        altDialogue: 'Welcome once again, sir; I hope you''re enjoying your stay!

          Is
          there anything I can do for you?'
        dialogueReference: {fileID: 0}
        condition:
          dialogueText: 'Fantastic! You can find your very own room number 2 upstairs,
            quite near our beautiful, temporarelly in reparations, sauna!

            Dinner
            will be served at 7pm'
