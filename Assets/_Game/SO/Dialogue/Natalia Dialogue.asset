          Part4: 1806386512
        tag: 
    - rid: 3046479065253412944
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Makes sense. Thank you for warning me.]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4599.43, y: 494.04}
    - rid: 3046479065253412945
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Is it not being repaired already?]'
        nextNode:
          rid: 3046479065253412946
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3007, y: 858.1599}
    - rid: 3046479065253412946
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "We'd love to fix it as soon as possible, but... right now,
          we can't seem to find the <b>keys</b> to enter. \nI could've sworn i was
          holding them myself... but, to be honest, this was a very exciting day
          for me, so I could have dropped them without noticing.\nThere's no need
          for you to worry about that, sir, but please, let me know if you find them
          somewhere around here."
        characterEmotion: 1
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253412947
        - rid: 3046479065253412948
