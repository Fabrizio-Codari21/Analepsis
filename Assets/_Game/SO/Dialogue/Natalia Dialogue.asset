    - rid: 6774952781063389257
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: May I inquire, what kind of people visit these parts?
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2947, y: -560}
    - rid: 6774952781063389258
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Hi, I''d like a room please.]'
        nextNode:
          rid: 6774952781063389259
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 885.85, y: 66.99999}
    - rid: 6774952781063389259
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why, thank you for choosing us, sir! It''s great to see people
          come in instead of passing by, for once.

          You can find your very
          own room no. 2 upstairs, quite near our beautiful, temporarily in reparations,
          sauna!

          Dinner will be served at 7pm, so please make yourself
          at home.'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
