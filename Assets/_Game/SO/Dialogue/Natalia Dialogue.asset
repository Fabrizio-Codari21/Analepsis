    - rid: 3046479065253413027
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Not a great trait to have, I would say.

          I appreciate
          the interest, but please understand if I choose to end this conversation
          right here.'
        characterEmotion: 2
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253413029
        isRootNode: 0
        editorPosition: {x: 5262.0347, y: -545.9999}
        altDialoguePaths: []
