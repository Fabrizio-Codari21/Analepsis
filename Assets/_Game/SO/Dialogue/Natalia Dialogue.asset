    - rid: 767062761356918904
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Really? Truly!? Oh how glad I am! Andrey is going to be so
          very happy to hear that. '
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
