    - rid: 767062761356918872
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[So you''re planning to spy on them?]'
        nextNode:
          rid: 767062761356918876
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4962, y: 431.99997}
    - rid: 767062761356918873
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Well, I couldn''t check those pictures anyway.]'
        nextNode:
          rid: 767062761356918877
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4962, y: 864.9999}
    - rid: 767062761356918874
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'I''m a <b>journalist</b>, mind you. I didn''t spend years
          of my life as the only woman in a prestigious journalism school just to
          be called a <b>reporter</b>.

          But now that you ARE getting curious,
          I''ll tell you: yes, I''m here as a journalist, getting into the least
          expected places to find the most <b>delicious</b> stories.

          No
          pun intended.'
        characterEmotion: 1
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
