          Part3: 4036692107
          Part4: 387059162
        tag: 
    - rid: 3046479065253413017
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Has that already happened to you here?]'
        nextNode:
          rid: 3046479065253413021
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3630.0352, y: -336.99988}
    - rid: 3046479065253413018
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Cameras? Like that journalist downstairs?]'
        nextNode:
          rid: 3046479065253413022
        dialogueTopic: 
        m_conditions:
        - rid: 3046479065253413023
        alreadyDisplayed: 0
        editorPosition: {x: 3583.0005, y: -91.999985}
    - rid: 3046479065253413019
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Thanks for the tip. (Ilya broke his car, then...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
