      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: (Shush) Would you mind telling him? The kitchen is right next
          to the dining room.
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
