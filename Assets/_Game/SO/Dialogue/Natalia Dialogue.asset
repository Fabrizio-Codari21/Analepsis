      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[I''m investigating a possible murder attempt.]'
        nextNode:
          rid: 3046479065253413028
        dialogueTopic: 
        m_conditions: []
