          Part4: 531188890
        tag: 
    - rid: 3046479065253413022
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Lucky for her, she seems to be a bit vain to care about politics
          and my role in them.

          Admittedly, that could make her even more
          suspicious... but her focus seems to be placed on Mr. Artist instead.

          He''s
          truly useless, but hey, at least his weirdness makes him the perfect distraction...
          heh...'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
