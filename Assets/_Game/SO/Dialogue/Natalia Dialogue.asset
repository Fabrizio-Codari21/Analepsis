    - rid: 767062761356918873
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Well, I couldn''t check those pictures anyway.]'
        nextNode:
          rid: 767062761356918877
        dialogueTopic: 
