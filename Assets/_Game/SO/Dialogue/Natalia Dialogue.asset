    - rid: 6774952781063389258
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Hi. I''d like a room, please.]'
        nextNode:
          rid: 6774952781063389259
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 885.85, y: 66.99999}
    - rid: 6774952781063389259
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why, thank you for choosing us, sir! It''s great to see people
          coming in instead of passing by, for once.

          You''ll find your
          very own room <b>no. 2</b> upstairs, quite near our beautiful, temporarily
          in reparations, sauna!

          Dinner will be served at 7pm, so please
          make yourself at home.'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
