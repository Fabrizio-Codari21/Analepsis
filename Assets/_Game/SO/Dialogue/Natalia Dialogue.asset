        targetDialogue: {fileID: 11400000, guid: a218568596dfcf9419f1f4c8eb4ff384, type: 2}
        isTalkDialogueNode:
          dialogueText: "You were lied to, then. \nIt's already bad enough that I
            had to lose my suite to some... filthy artist; I'm not going to negotiate
            with a mere commoner like you.\nYou better find another room... or sleep
            downstairs, for all I care."
          characterEmotion: 3
