    - rid: 3046479065253413020
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(It certainly is strange...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 2997, y: 416}
    - rid: 3046479065253413021
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why do you think I chose a place in the middle of nowhere
          such as this?

          Trust me, I know how to deal with these things...
          some day, someone will get me, but today is not that day, I know it...

          Then
          again, I''m not entirely sure why someone like you is so interested on
          my safety... unless...'
        characterEmotion: 2
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479065253413024
        - rid: 3046479065253413025
        isRootNode: 0
        editorPosition: {x: 4025.8733, y: -382.50006}
