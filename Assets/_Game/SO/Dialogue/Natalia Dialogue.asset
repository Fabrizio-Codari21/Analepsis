    - rid: 6774952781063389310
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Honestly I don''t know why anyone would ever want to come
          here!

          There''s absolutely nothing to be found in the barren
          wasteland.

          Come to think of it, what are <b>you<\b> doing here?'
        characterEmotion: 0
        characterReaction: 0
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 6774952781063389312
        - rid: 6774952781063389313
        isRootNode: 0
