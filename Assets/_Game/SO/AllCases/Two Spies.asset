          Part3: 3820204718
          Part4: 2833258252
        tag: 
    - rid: 3046479087689794104
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Good to know. (What are you plotting?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
