          rid: 3046479087689794118
    - rid: 3046479087689794118
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'So far, so good. The <b>target</b> has already gone upstairs,
          and the door sign says it''s unlocked.

          I''ve been really nice
          to everyone and no-one seens to suspect a thing.

          If things keep
          going as planned, I''ll be in there right before dinner, ready to <b>complete
          the task</b>...'
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
