    - rid: 3046479097160532490
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[The sign says it''s open, though.]'
        nextNode:
          rid: 3046479097160532481
        dialogueTopic: 
        m_conditions:
        - rid: 3046479097160532493
        alreadyDisplayed: 0
        editorPosition: {x: 4294, y: 1217.1599}
    - rid: 3046479097160532491
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Why, of course not! No one can enter that place without the
          key, not even myself.

          And, even if they could, we have some
          strict policies about making loud noises during the afternoon.

          If
          someone was making noise in their room upstairs, we''d surely have done
          something about it.'
        characterEmotion: 2
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
