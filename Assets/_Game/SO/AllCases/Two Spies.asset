          Part4: 721459554
        tag: 
    - rid: 3046479087689794156
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(What''s going on with that sign?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 5546, y: 1217.1599}
    - rid: 3046479087689794157
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 3046479087689794118
    - rid: 3046479087689794158
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 3046479087689794159
    - rid: 3046479087689794159
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Well, you''re the first and only person to come into this
          room, and the door to "the place" is still closed, so nothing''s gone wrong
          so far.

          Though, of course, I didn''t account on you being a
          part of this so, please don''t get in the way.

          This is a very
          serious business for me, alright?'
        characterEmotion: 1
        characterReaction: 6
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 3046479087689794160
        isRootNode: 0
        editorPosition: {x: 2239, y: -573.1084}
        altDialoguePaths: []
        guid:
          Part1: 1793333401
          Part2: 1171380598
          Part3: 3820204718
          Part4: 2833258252
        tag: 
    - rid: 3046479087689794160
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Good to know. (What are you plotting?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3346, y: -573}
    - rid: 3046479087689794161
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 3046479087689794162
    - rid: 3046479087689794162
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Then do me a favour and remind him that I said MANY TIMES
          that I would be the one taking care of that.

          And make sure that
          he keeps in mind that he''s in debt with me, and that he''s still <b>alive</b>
          for a reason.'
        characterEmotion: 3
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
