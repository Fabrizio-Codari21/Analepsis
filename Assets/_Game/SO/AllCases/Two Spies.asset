          rid: 3046479097160532326
    - rid: 3046479097160532326
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'So he DID get a <b>third</b> member for the team! I knew it!

          See,
          I told him that a mission like this would require more hands, but he was
          too proud to admit that I was right.

          I respect him a lot, he
          was like a... weird, creepy father to me... but, man, a <b>figure that
          important</b> could not go down without help... '
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
