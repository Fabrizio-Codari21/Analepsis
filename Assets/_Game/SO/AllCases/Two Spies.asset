    - rid: 3046479097160532014
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "So far, so good. The <b>target</b> has already gone upstairs,
          and the door to \"the place\" seems to be unlocked, so it should be easy
          to get him to fall for the <b>trap</b>. \nI've been really nice to everyone
          and no-one seems to suspect a thing.\nIf things keep going as planned,
          I'll be in there right before dinner, ready to <b>complete the task</b>..."
        characterEmotion: 4
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
