    - rid: 8019692236963578280
      type: {class: 'ClueHolder`1[[NpcIdentity, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget: {fileID: 11400000, guid: a92984fab3971114f8ff115e44df5760, type: 2}
    - rid: 8019692236963578281
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 8019692236963578282
    - rid: 8019692236963578282
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'What? That... doesn''t make any sense.

          Unless...
          oh no, was he scolding me for not doing my research properly?

          I
          swear i found everything I could about that guy... wait... I mean... science!
          We''re scientist doing research, that''s what I meant... um... yeah.'
        characterEmotion: 5
        characterReaction: 0
        doesItProveAnything: 4
        isKey: 0
        responses:
        - rid: 8019692236963578283
        isRootNode: 0
        editorPosition: {x: 3102.5059, y: 810.482}
        altDialoguePaths: []
        guid:
          Part1: 209685302
          Part2: 1101052138
          Part3: 4035769758
          Part4: 1513944887
        tag: 
    - rid: 8019692236963578283
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(I doubt you''ve researched Oleg "for science"...)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4146, y: 726.5}
    - rid: 8019692236963578284
      type: {class: 'ClueHolder`1[[Item, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget: {fileID: 11400000, guid: f243d9958ead79545b599d03db2e8738, type: 2}
    - rid: 8019692236963578285
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 8019692236963578286
    - rid: 8019692236963578286
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "Oh, no, I cannot allow that, sir... even if I could get in,
          \nI wouldn't want to limit your experience here, but you have to understand:
          right now, it's not safe to go in without the right protection.\nThe temperature
          could be way off, a pipe could be perforated and leaking who-knows-what...
          it could be <b>fatal</b> if I let anyone in right now."
        characterEmotion: 1
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 8019692236963578287
        isRootNode: 0
        editorPosition: {x: 3325.0005, y: 621}
        altDialoguePaths: []
        guid:
          Part1: 801171743
          Part2: 1177470563
          Part3: 1156241831
          Part4: 1806386512
        tag: 
    - rid: 8019692236963578287
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[Makes sense. Thank you for warning me.]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 4391, y: 565.7092}
    - rid: 8019692236963578288
      type: {class: 'ClueHolder`1[[DialogueNode, Assembly-CSharp]]', ns: , asm: Assembly-CSharp}
      data:
        m_clueTarget:
          rid: 8019692236963578289
    - rid: 8019692236963578289
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: "I wish that was the case... but where could I possibly go?
          The sauna won't open, the kitchen is locked as well. \nAnd I'm absolutely
          NOT going back in my bedroom, after all that <b>chaos</b> going on upstairs
          that I had to put up with for HOURS.\nAll that is left is this table, unless
          you can think of something better. "
        characterEmotion: 5
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 8019692236963578290
        isRootNode: 0
        editorPosition: {x: 2901.85, y: 492.00003}
        altDialoguePaths: []
        guid:
          Part1: 3403335406
          Part2: 1326432269
          Part3: 3950741638
          Part4: 921685745
        tag: 
    - rid: 8019692236963578290
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[<b>Chaos</b>? What do you mean?]'
        nextNode:
          rid: 8019692236963578291
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 3767.0007, y: 455.3501}
    - rid: 8019692236963578291
      type: {class: DialogueNode, ns: , asm: Assembly-CSharp}
      data:
        dialogueText: 'Hah! Well, either there''s an invisible construction site
          next to this hotel, or someone near the suite <b>no. 1</b> has a really
          LOUD hobby.

          When I came to a place as desolated as this one,
          it''s because I was expecting to be away from the sounds of the city.

          But
          no: hammer strikes, drill roars, any industrial sound imaginable seems
          to follow me... and to think the host told me this was "her best room"...'
        characterEmotion: 1
        characterReaction: 2
        doesItProveAnything: 0
        isKey: 0
        responses:
        - rid: 8019692236963578292
        isRootNode: 0
        editorPosition: {x: 4142, y: 487}
        altDialoguePaths: []
        guid:
          Part1: 931422527
          Part2: 1218130906
          Part3: 1804454273
          Part4: 2257800816
        tag: 
    - rid: 8019692236963578292
      type: {class: DialogueResponse, ns: , asm: Assembly-CSharp}
      data:
        responseText: '[(What could those sounds be?)]'
        nextNode:
          rid: -2
        dialogueTopic: 
        m_conditions: []
        alreadyDisplayed: 0
        editorPosition: {x: 5057, y: 487}
